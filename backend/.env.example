# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1
BASE_URL=http://localhost:5000
# Browser-facing URL used when generating QR and digital-pass links. For a
# phone demo, replace localhost with this computer's LAN IP (for example,
# http://192.168.1.100:5173).
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/qr-registration-platform

# CORS: optional. Comma-separated list of allowed browser origins. Leave
# unset to allow exactly FRONTEND_URL (the common case) — only set this
# separately if you need to allow more than one origin at once (e.g. also
# allowing a LAN IP for testing on a phone alongside localhost).
# CORS_ORIGIN=http://localhost:5173,http://192.168.1.100:5173

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_DRAFT_SECRET=change_this_draft_secret
JWT_DRAFT_EXPIRES_IN=24h
JWT_PILGRIM_SECRET=change_this_pilgrim_secret
JWT_PILGRIM_EXPIRES_IN=7d

# Pilgrim ID generation (KP{year}{regionCode}{6-digit sequence})
PILGRIM_ID_REGION_CODE=XX

# Cloudinary (document uploads). Optional — the app boots without these,
# but upload endpoints return a clear error until real values are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=qr-registration
CLOUDINARY_FOLDER=qr-registration

# Security
BCRYPT_SALT_ROUNDS=12

# Initial admin seed (used by npm run seed:admin)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
